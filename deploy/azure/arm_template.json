{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "ChurnGuard MLOps Infrastructure on Azure",
    "description": "ARM Template for deploying Azure Container Apps, Azure Blob Storage, Azure Container Registry, and Azure Managed Redis (AMR Balanced B0) for ChurnGuard MLOps Platform."
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "env-churnguard-mlops",
      "metadata": { "description": "Name of the Container Apps Managed Environment" }
    },
    "appName": {
      "type": "string",
      "defaultValue": "churnguard-serving-app",
      "metadata": { "description": "Name of the Container App" }
    },
    "acrName": {
      "type": "string",
      "defaultValue": "churnguardacr",
      "metadata": { "description": "Name of the Azure Container Registry" }
    },
    "acrSku": {
      "type": "string",
      "defaultValue": "Basic",
      "allowedValues": ["Basic", "Standard", "Premium"],
      "metadata": { "description": "Azure Container Registry SKU (Basic for student FinOps budget; Premium enables Disabled publicNetworkAccess)" }
    },
    "redisName": {
      "type": "string",
      "defaultValue": "redis-churnguard-sea",
      "metadata": { "description": "Name of the Azure Managed Redis (AMR Balanced B0) instance" }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "stchurnguardsea2026",
      "metadata": { "description": "Globally unique Azure Storage Account name" }
    },
    "location": {
      "type": "string",
      "defaultValue": "southeastasia",
      "metadata": { "description": "Azure Region (Southeast Asia - Singapore)" }
    },
    "apiKeyToken": {
      "type": "securestring",
      "metadata": { "description": "Serving API X-API-Key token supplied at deployment time" }
    },
    "kkboxAuthToken": {
      "type": "securestring",
      "metadata": { "description": "KKBox v1 Serving API x-api-key token supplied at deployment time" }
    }
  },
  "variables": {
    "blobContainerName": "churnguard-datasets",
    "userIdentityName": "id-churnguard-mlops-sea",
    "acrPullRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
    "storageBlobContributorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
    "containerImage": "[format('{0}.azurecr.io/churnguard-mlops:latest', parameters('acrName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('userIdentityName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[parameters('acrName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('acrSku')]"
      },
      "properties": {
        "adminUserEnabled": false,
        "publicNetworkAccess": "[if(equals(parameters('acrSku'), 'Premium'), 'Disabled', 'Enabled')]"
      }
    },
    {
      "type": "Microsoft.ContainerRegistry/registries/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[format('{0}/Microsoft.Authorization/{1}', parameters('acrName'), guid(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), variables('userIdentityName'), 'AcrPull'))]",
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userIdentityName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('acrPullRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userIdentityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "publicNetworkAccess": "Disabled",
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "Deny"
        },
        "encryption": {
          "services": {
            "blob": {
              "enabled": true
            }
          },
          "keySource": "Microsoft.Storage",
          "requireInfrastructureEncryption": true
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default', parameters('storageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "deleteRetentionPolicy": {
          "enabled": true,
          "days": 7
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/queueServices",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default', parameters('storageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "logging": {
          "delete": true,
          "read": true,
          "write": true,
          "retentionPolicy": {
            "enabled": true,
            "days": 7
          }
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default/{1}', parameters('storageAccountName'), variables('blobContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccountName'), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[format('{0}/Microsoft.Authorization/{1}', parameters('storageAccountName'), guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), variables('userIdentityName'), 'StorageBlobDataContributor'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userIdentityName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('storageBlobContributorRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userIdentityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Cache/redisEnterprise",
      "apiVersion": "2024-09-01-preview",
      "name": "[parameters('redisName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Balanced_B0",
        "capacity": 1
      },
      "properties": {
        "minimumTlsVersion": "1.2"
      },
      "resources": [
        {
          "type": "databases",
          "apiVersion": "2024-09-01-preview",
          "name": "default",
          "dependsOn": [
            "[parameters('redisName')]"
          ],
          "properties": {
            "clientProtocol": "Encrypted",
            "port": 10000,
            "clusteringPolicy": "EnterpriseCluster",
            "evictionPolicy": "VolatileLRU"
          }
        }
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2023-05-01",
      "name": "[parameters('environmentName')]",
      "location": "[parameters('location')]",
      "properties": {
        "zoneRedundant": false
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userIdentityName'))]": {}
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]",
        "[resourceId('Microsoft.Cache/redisEnterprise', parameters('redisName'))]",
        "[resourceId('Microsoft.ContainerRegistry/registries/providers/roleAssignments', parameters('acrName'), 'Microsoft.Authorization', guid(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), variables('userIdentityName'), 'AcrPull'))]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "configuration": {
          "secrets": [
            {
              "name": "api-key-token",
              "value": "[parameters('apiKeyToken')]"
            },
            {
              "name": "kkbox-auth-token",
              "value": "[parameters('kkboxAuthToken')]"
            },
            {
              "name": "redis-access-key",
              "value": "[listKeys(resourceId('Microsoft.Cache/redisEnterprise/databases', parameters('redisName'), 'default'), '2024-09-01-preview').primaryKey]"
            }
          ],
          "registries": [
            {
              "server": "[format('{0}.azurecr.io', parameters('acrName'))]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userIdentityName'))]"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 8000
          }
        },
        "template": {
          "containers": [
            {
              "name": "churnguard-serving",
              "image": "[variables('containerImage')]",
              "resources": {
                "cpu": 1.0,
                "memory": "2.0Gi"
              },
              "env": [
                {
                  "name": "APP_ENV",
                  "value": "production"
                },
                {
                  "name": "API_KEY",
                  "secretRef": "api-key-token"
                },
                {
                  "name": "KKBOX_API_KEY",
                  "secretRef": "kkbox-auth-token"
                },
                {
                  "name": "MLFLOW_TRACKING_URI",
                  "value": "sqlite:////app/data/kkbox_models/mlflow.db"
                },
                {
                  "name": "REDIS_HOST",
                  "value": "[reference(resourceId('Microsoft.Cache/redisEnterprise', parameters('redisName'))).hostName]"
                },
                {
                  "name": "REDIS_PORT",
                  "value": "10000"
                },
                {
                  "name": "REDIS_SSL",
                  "value": "true"
                },
                {
                  "name": "AZURE_REDIS_PASSWORD",
                  "secretRef": "redis-access-key"
                },
                {
                  "name": "AZURE_STORAGE_CONTAINER",
                  "value": "[variables('blobContainerName')]"
                },
                {
                  "name": "AZURE_STORAGE_ACCOUNT_URL",
                  "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))).primaryEndpoints.blob]"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 5
          }
        }
      }
    }
  ],
  "outputs": {
    "appFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('appName'))).configuration.ingress.fqdn]"
    },
    "storageEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))).primaryEndpoints.blob]"
    },
    "redisHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Cache/redisEnterprise', parameters('redisName'))).hostName]"
    },
    "redisSslPort": {
      "type": "int",
      "value": 10000
    }
  }
}
